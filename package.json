{
  "name": "footy-data-kit",
  "version": "1.0.0",
  "description": "Generate and clean your footy data for your next project.",
  "type": "module",
  "scripts": {
    "wiki:build:promotion": "node wikipedia/cli/index.js build --start 1888 --end 1990 --output ./data-output --force-update --ignore-war-years",
    "wiki:build:overview": "node wikipedia/cli/index.js overview --start 1888 --end 2025 --output ./data-output --force-update --include-war-placeholders",
    "wiki:build:lower-tiers": "node wikipedia/cli/index.js lower-tiers --start 1979 --end 2025 --output ./data-output --force-update",
    "wiki:build:combined": "node wikipedia/data/combine-output-files.js --output ./data-output/all-seasons.json ./data-output/wiki_overview_tables_by_season.json",
    "wiki:club-seed": "node wikipedia/data/generate-club-metadata-seed.js ./data-output/all-seasons.json --output ./data/club-metadata.json",
    "wiki:club-historical-audit": "node wikipedia/data/verify-club-continuity.js --check-historical-reasons --suggest-historical-reasons-from-wikipedia --wikipedia-limit 1000 --output ./data/club-historical-reason-audit.json",
    "wiki:club-historical-audit:check": "node wikipedia/data/verify-club-continuity.js --check-historical-reasons --fail-on-issues",
    "wiki:club-verify": "node wikipedia/data/verify-club-continuity.js",
    "wiki:verify": "node wikipedia/data/verify-football-data.js --fail-on-issues ./data-output",
    "schema:verify": "node wikipedia/data/verify-json-schemas.js",
    "verify:data": "pnpm -s wiki:verify && pnpm -s wiki:club-historical-audit:check && pnpm -s schema:verify",
    "codex:links": "node scripts/dev/setup-codex-links.mjs",
    "wiki:minify:promotion": "node scripts/minify-json.js ./data-output/wiki_promotion_relegations_by_season.json",
    "wiki:minify:overview": "node scripts/minify-json.js ./data-output/wiki_overview_tables_by_season.json",
    "wiki:minify:combined": "node scripts/minify-json.js ./data-output/all-seasons.json",
    "docs:build": "node scripts/build-docs-site.js",
    "docs:check": "node scripts/build-docs-site.js --check",
    "release-notes:check": "node scripts/validate-release-notes.js",
    "release-notes:check:all": "node scripts/validate-release-notes.js --all",
    "release:check": "pnpm -s release-notes:check && pnpm -s docs:check",
    "release:dry-run-data": "node scripts/release-dry-run-data.js",
    "integration:coverage": "node scripts/report-integration-coverage.js",
    "build:wikipedia:promotion": "pnpm wiki:build:promotion",
    "build:wikipedia:overview": "pnpm wiki:build:overview",
    "build:wikipedia:lower-tiers": "pnpm wiki:build:lower-tiers",
    "build:wikipedia:combined": "pnpm wiki:build:combined",
    "verify:wikipedia": "pnpm wiki:verify",
    "minify:wikipedia:promotion": "pnpm wiki:minify:promotion",
    "test:jest": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test": "pnpm -s test:jest",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.integration.config.js",
    "test:integration:promotion": "cross-env NODE_OPTIONS=--experimental-vm-modules WIKI_TEST_SOURCE=promotion jest -c jest.integration.config.js",
    "test:integration:overview": "cross-env NODE_OPTIONS=--experimental-vm-modules WIKI_TEST_SOURCE=overview jest -c jest.integration.config.js",
    "test:coverage": "pnpm -s test:jest -- --coverage",
    "test:watch": "pnpm -s test:jest -- --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.mjs,.ts",
    "lint:fix": "eslint . --ext .js,.mjs,.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "soccer",
    "football",
    "soccer-data",
    "football-data",
    "data-parser",
    "data-cleaning",
    "wikipedia",
    "web-scraping"
  ],
  "author": {
    "name": "Dylan Steele",
    "email": "dylansteele57@gmail.com"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "cheerio": "^1.1.2",
    "commander": "^14.0.2",
    "entities": "^6.0.1",
    "fast-csv": "^5.0.5",
    "wikipedia": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "ajv": "8.17.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "jest": "^29.7.0",
    "lefthook": "^1.13.6",
    "lint-staged": "^16.2.6",
    "mustache": "^4.2.0",
    "prettier": "^2.8.8",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,ts,json,md}": [
      "prettier --write",
      "git add"
    ],
    "*.{js,mjs,ts}": [
      "eslint --fix",
      "git add"
    ]
  }
}
