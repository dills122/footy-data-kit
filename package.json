{
  "name": "footy-data-kit",
  "version": "0.6.1",
  "description": "Generate and clean your footy data for your next project.",
  "type": "module",
  "scripts": {
    "wiki:build:promotion": "node wikipedia/cli/index.js build --start 1888 --end 1990 --output ./data-output --force-update --ignore-war-years",
    "wiki:build:overview": "node wikipedia/cli/index.js overview --start 1888 --end 2024 --output ./data-output --force-update --include-war-placeholders",
    "wiki:build:combined": "node wikipedia/data/combine-output-files.js --output ./data-output/all-seasons.json ./data-output/wiki_overview_tables_by_season.json",
    "wiki:verify": "node wikipedia/data/verify-football-data.js --fail-on-issues ./data-output",
    "wiki:minify:promotion": "node scripts/minify-json.js ./data-output/wiki_promotion_relegations_by_season.json",
    "wiki:minify:overview": "node scripts/minify-json.js ./data-output/wiki_overview_tables_by_season.json",
    "wiki:minify:combined": "node scripts/minify-json.js ./data-output/all-seasons.json",
    "build:wikipedia:promotion": "pnpm wiki:build:promotion",
    "build:wikipedia:overview": "pnpm wiki:build:overview",
    "build:wikipedia:combined": "pnpm wiki:build:combined",
    "verify:wikipedia": "pnpm wiki:verify",
    "minify:wikipedia:promotion": "pnpm wiki:minify:promotion",
    "test:jest": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test": "pnpm -s test:jest",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.integration.config.js",
    "test:integration:promotion": "cross-env NODE_OPTIONS=--experimental-vm-modules WIKI_TEST_SOURCE=promotion jest -c jest.integration.config.js",
    "test:integration:overview": "cross-env NODE_OPTIONS=--experimental-vm-modules WIKI_TEST_SOURCE=overview jest -c jest.integration.config.js",
    "test:coverage": "pnpm -s test:jest -- --coverage",
    "test:watch": "pnpm -s test:jest -- --watch",
    "lint": "eslint . --ext .js,.mjs",
    "lint:fix": "eslint . --ext .js,.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "soccer",
    "football",
    "soccer-data",
    "football-data",
    "data-parser",
    "data-cleaning",
    "wikipedia",
    "web-scraping"
  ],
  "author": {
    "name": "Dylan Steele",
    "email": "dylansteele57@gmail.com"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "cheerio": "^1.1.2",
    "commander": "^14.0.2",
    "entities": "^6.0.1",
    "fast-csv": "^5.0.5",
    "wikipedia": "^2.4.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "prettier": "^2.8.8",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.6",
    "lefthook": "^1.13.6"
  },
  "lint-staged": {
    "*.{js,mjs,json,md}": [
      "prettier --write",
      "git add"
    ],
    "*.{js,mjs}": [
      "eslint --fix",
      "git add"
    ]
  }
}
